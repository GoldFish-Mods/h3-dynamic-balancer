ZVSE2


!#DC(H3DB_HISTORY_EMPTY)      = -999; (не трогать)

; ---------------------------------


!#DC(H3DB_LOG) = 1;   [log type -2...5] 5 default i^h3db_LOG^



; Game logic Modifers --------------

; Минимальный запас ресурсов (кроме золота), до которого не действуют жесткие штрафы на прирост
!#DC(H3DB_MIN_RES_FOR_REDUCE) = 15;   i^h3db_minResForReduce^

; Задержка запуска балансировки в днях
!#DC(H3DB_START_FROM_DAY)    = 10;   i^h3db_startFromDay^

; Ручная корректировка перевеса сил (-100..+100)
; -100 максимум помощи игроку; +100 максимум помощи ИИ
!#DC(H3DB_ADJUSTMENT_AMOUNT) = 0;    i^h3db_adjustmentAmount^

; Константы настройки сглаживания перевеса (EMA) ---

; Скорость реакции баланса при росте перевеса сил (1..100%)
; Чем меньше %, тем мягче адаптация без резких скачков; чем больше %, тем жестче игра балансирует
!#DC(H3DB_EMA_GROWTH_PCT)    = 45;   i^h3db_emaGrowthPct^

; Скорость реакции баланса при снижении перевеса сил (1..100%)
; Чем меньше %, тем плавнее спадают штрафы; чем больше %, тем быстрее игра возвращается к норме
!#DC(H3DB_EMA_DECAY_PCT)     = 75;   i^h3db_emaDecayPct^

; Порог мгновенной доводки баланса (в пунктах 0..100)
; Чем выше порог, тем раньше игра отсекает плавный набор и выставляет значение сразу
!#DC(H3DB_EMA_SNAP_THRESHOLD) = 5;    i^h3db_emaSnapThreshold^

