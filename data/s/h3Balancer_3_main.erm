; Выводим текущие значения из переменных в диалог
!!IF:M^{~Gold}Current Settings in Memory (H3Balancer){~}

{~83E7FFFF}1. From mod folder (h3Balancer.ini):{~}
logToFile = {%i(h3db_LOG)}

{~83E7FFFF}2. From Runtime (h3Balancer_preset.ini):{~}
[difficulty]
startFromDay = {%i(h3db_startFromDay)}
adjustmentAmount = {%i(h3db_adjustmentAmount)}

[smoothing]
emaGrowthPct = {%i(h3db_emaGrowthPct)}
emaDecayPct = {%i(h3db_emaDecayPct)}
emaSnapThreshold = {%i(h3db_emaSnapThreshold)}

[aiResourceModifiers]
minResForReduce = {%i(h3db_minResForReduce)}^;



