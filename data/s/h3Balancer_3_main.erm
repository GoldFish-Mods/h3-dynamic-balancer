!?FU(h3db_BattleEmulator);
!!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^START FAKE COMBAT...^/1;
!!VR(combiningArmy:y):S1;

; Инициализируем переменную для героя человека (по умолчанию -1, если нет героя)
!!VR(humanHero:y):S-1;

; 1. Глобальный снимок карты для логгера (без изменений, содержит всех героев)
!!FU(h3db_SavePlayersArmyState):P?(armyBefore:y);

!!FU(NewIntArray):P0/0/?(sourcesArr:y)/(M_STORED);
!!FU(NewIntArray):P0/0/?(heroTownsArr:y)/(M_STORED);
!!FU(NewIntArray):P0/0/?(armyBackup:y)/(M_STORED);

; 2. Новый массив ТОЛЬКО для сильнейших героев ИИ (Чемпионов)
!!FU(NewIntArray):P0/0/?(aiChampionsArr:y)/(M_STORED);
!!FU(h3db_WriteLog):P^^;

; ЭТАП 1: Поиск чемпионов, бэкапы и слияние
!!re (currPlayer:y)/0/(PLAYER_LAST);
  !!OW:I(currPlayer)/?(isAi:y)/?(isDead:y);
  !!if&(isDead)=0;
    !!FU(h3db_PlayerId_GetMostPowerfullHeroId):P(currPlayer)/?(strongestHeroId:y);
    !!if&(strongestHeroId)>-1;
      !!if&(isAi)=0;
        !!VR(humanHero):S(strongestHeroId);
      !!el;
        !!FU(Array_Push):P(aiChampionsArr)/(strongestHeroId);
      !!en;
      !!FU(h3db_CreateArmyBackup):P(strongestHeroId)/(armyBackup);
      !!VR(heroSlot:y):S-1;
      !!VR(townId:y):S-1;
      !!if&(combiningArmy)=1;
        !!FU(h3db_CombiningPlayerArmy):P(currPlayer)/(strongestHeroId)/(sourcesArr)/?(heroSlot)/?(townId);
      !!en;
      !!FU(Array_Push):P(heroTownsArr)/(strongestHeroId)/(heroSlot)/(townId);
    !!en;
  !!en;
!!en;

; ЭТАП 2: Логирование (используем глобальный массив armyBefore)
!!if&i^h3db_LOG^>0;
  *!FU(h3db_WriteLog):P^^;
  !!FU(h3db_WriteLog):P^?  STATE BEFORE FAKE COMBAT:^/1;
  !!FU(h3db_LogPlayersStateDiff):P(armyBefore)/(sourcesArr)/(heroTownsArr);
!!el;
  !!SN:M(armyBefore);
  !!SN:M(sourcesArr);
  !!SN:M(heroTownsArr);
!!en;

; ЭТАП 3: Серия боёв (Человек против Чемпионов ИИ)

; Проверка безопасности: бои идут только если у человека есть герой
!!if&(humanHero)>-1;
  !!SN:M(aiChampionsArr)/?(champsCount:y);
  !!VR(lastIdx:y):S(champsCount) -1;

  ; Если есть хотя бы один чемпион ИИ в турнирной сетке
  !!if&(lastIdx)>=0;
    !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^^;
        ; формируем тип земли для битвы на ней
        !!TR0/0/0:T?(type:y)/?(sub:y)/?(riv:y)/?(rivDir:y)/?(road:y)/?(roadDir:y)/?(magic:y)/?(flags:y);
        !!TR0/0/0:T1/0/0/0/0/0/0/0;
        !!UN:P760/?(optionAchievStatus:y);!!UN:P760/0; опция "достижения" выкл
        !!UN:P207/?(option207:y);!!UN:P35/?(option35:y);!!UN:P207/0;!!VRi^wog_207_enabled^:S0;!!UN:P35/0;!!VRi^wog_35_enabled^:S0;  ; навыки мистицизма ВЫКЛ
        !!UN:P201/?(option201:y);!!UN:P201/0;!!VRi^wog_201_enabled^:S0; артилерия

    !!re (idx:y)/0/(lastIdx);
      ; 1. Извлекаем чемпиона ИИ из массива турнирной сетки и узнаем его владельца
      !!SN:M(aiChampionsArr)/(idx)/?(aiHero:y);
      !!HE(aiHero):O?(heroOwner:y);
      !!if&i^h3db_LOG^>0;
        !!FU(GetTextFileString):P^plcolors.txt^/(heroOwner)/?(heroOwnerStr:z);
        !!HE(aiHero):B0/?(heroName:z);
        !!FU(h3db_WriteLog):P^COMBAT: start  -  HUMAN vs %(heroOwnerStr) _ (%(heroName)) _^/1;
      !!en;

      ; 2. Проводим эмуляцию боя
      !!FU(h3db_StartHeroesCombat):P(humanHero)/(aiHero)/0/0/0/(H3DB_ALLOW_MAGIC)/(H3DB_BLOCK_RETREAT)/(H3DB_NO_SPECIAL_TERRAIN)/?(winnerSide:y);
      
      ; Защита: пропускаем шаг, если эмуляция завершилась сбоем
      !!if|(winnerSide)=(H3DB_SIDE_WINNER_COMBAT_FAILED)/(winnerSide)=(H3DB_SIDE_WINNER_DRAW);
        !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^^;
        !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^[ERROR]     FAKE COMBAT: FAILED  result: %(winnerSide)^;
        !!co;
      !!en;

      ; 3. Определяем победившего героя
      !!if&(winnerSide)=(BATTLE_LEFT);
        !!VR(winnerHero:y):S(humanHero);
      !!el;
        !!VR(winnerHero:y):S(aiHero);
      !!en;
      !!if|i^h3db_LOG^=2/i^h3db_LOG^=-2;
        !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^            COMBAT: process..  (output result to dialog)^;
      !!el;
        !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^            COMBAT: process..^;
      !!en;

      ; 4. Оцениваем знаковое тактическое преимущество по итогам боя (-100..+100)
      !!FU(h3db_GetEvaluatedCombatAdvantage):P(winnerSide)/(heroOwner)/(winnerHero)/?(overbalanceMag:y);

      ; 5. Корректируем перевес стратегическими факторами (артефакты / заклинания)
      !!FU(h3db_ApplyStrategicAdvantage):P(humanHero)/(aiHero)/(overbalanceMag)/?(finalMag:y);

      ; 6. Сглаживаем величину перевеса (безмассивное инерционное сглаживание EMA)
      !!FU(h3db_SmoothOverbalance):P(aiHero)/(finalMag)/?(smoothedMag:y);

      ; 7. Применяем штрафы или бонусы к экономике ИИ
      !!FU(h3db_ApplyAIDifficultyMod):P(aiHero)/(smoothedMag);
      !!if&i^h3db_LOG^=-1;
        !!HE(aiHero):O?(aiColor:y);
        !!FU(GetTextFileString):P^plcolors.txt^/(aiColor)/?(aiSideStr:z);
        !!HE(winnerHero):B0/?(heroName:z) O?(winColor:y);
        !!FU(GetTextFileString):P^plcolors.txt^/(winColor)/?(winSideStr:z);
        !!IF:M^{~83E7FFFF}PLAYER{~} vs {%(aiSideStr)} WIN: {~83E7FFFF}%(winSideStr){~}%T(era.endl)HERO (winner): {~83E7FFFF}%(heroName){~}
        %T(era.endl)MAGnitude: {%(overbalanceMag)}%T(era.endl)MAG Smooth: {%(smoothedMag)}^;
      !!el&i^h3db_LOG^>0;
        !!FU(h3db_WriteLog):P^            MAG Smooth: %(smoothedMag)^;
      !!en;

      !!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^^;
    !!en;
      !!TR0/0/0:T(type)/(sub)/(riv)/(rivDir)/(road)/(roadDir)/(magic)/(flags);
      !!UN:P760/(optionAchievStatus); опция "достижения" выкл
      !!UN:P207/(option207);!!VRi^wog_207_enabled^:S(option207);!!UN:P35/(option35);!!VRi^wog_35_enabled^:S(option35);  ; навыки мистицизма ВКЛ
      !!UN:P201/(option201);!!VRi^wog_201_enabled^:S(option201);
  !!en;
!!en;

!!if&i^h3db_LOG^>0;
  !!FU(h3db_WriteLog):P^^;
  !!FU(h3db_WriteLog):P^FAKE COMBAT: DONE^/1;
!!en;

; 8. Восстанавливаем резервную копию армий
!!FU(h3db_RestoreArmyBackup):P(armyBackup);
!!FU(h3db_WriteLog)&i^h3db_LOG^>0:P^RestoreArmyBackup: DONE^/1;

