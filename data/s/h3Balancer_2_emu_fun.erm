!#DC(H3DB_BLOCK_MAGIC) = 1;                      [используется, чтобы запретить магию в бою]

!#DC(H3DB_ALLOW_RETREAT) = 0;                    [используется, чтобы разрешить сбегать из боя]
!#DC(H3DB_BLOCK_RETREAT) = 1;                    [используется, чтобы запретить сбегать из боя]

