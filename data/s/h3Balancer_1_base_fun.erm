!!UN:C6304144/4/-1879043902;

!?FU(UnfreezeScreen);
!!if&i^util_WinRedrawVar^<>0;
  !!UN:C6304144/4/i^util_WinRedrawVar^;
  !!VRi^util_WinRedrawVar^:S0;
  !!SN:D;
!!en;


!?FU(h3db_GetPluginVersion);
!#VA(versionStr:x);
!!FU(h3db_GetPluginFunction):P^Utils_CombatEmulator.era^/^GetVersion^/?(function:y);
!!if&(function);
  !!SN:E(function)/(CALLCONV_STDCALL);
  !!SN:Bv1/d/?(version:z);
