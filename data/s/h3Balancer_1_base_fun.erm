!!VR(versionStr):Z(version);








; ####################################################
; ----------------------------------------------------
; ----------------------------------------------------
; ----------------------------------------------------



  ;              FUNCTIONS  ---   INI


; инициализация и чтение обоих INI-файлов
!?FU(h3db_InitAndLoadAllConfigs);
!#VA(forceFromMod:x);

; 1. Читаем основной конфиг напрямую из папки мода (без записи в Runtime)
!!FU(h3db_LoadMainModIni):P;
; 2. Синхронизируем и читаем файл пресета (при forceFromMod=1 приоритет у папки мода)
!!FU(h3db_LoadAndSyncPresetIni):P(forceFromMod);

; Чтение базового h3Balancer.ini (Только из папки мода)
; Если файл удален — автоматически подставляются константы H3DB_...
!?FU(h3db_LoadMainModIni);
; Сбрасываем кэш в памяти, чтобы подхватить свежие правки из папки мода
!!FU(ClearIniCache):P^h3Balancer.ini^;

; Читаем ключи. Если файла или ключа нет — берутся константы по умолчанию
!!FU(ReadIniInts):P^h3Balancer.ini^/^main^/
  ^logToFile^/?i^h3db_LOG^/(H3DB_LOG);


; Синхронизация и чтение h3Balancer_preset.ini (Мод -> Runtime)
; Обеспечивает:
;   1. Приоритет настроек игрока из Runtime/h3Balancer_preset.ini
;   2. Дозапись новых ключей из папки мода при их отсутствии после обновления
;   3. Защиту константами и авто-генерацию файла, если удалены оба INI
!?FU(h3db_LoadAndSyncPresetIni);
!#VA(forceFromMod:x); [Если передан 1 — принудительно берем значения из папки мода и перезаписываем Runtime]

; 1. Очищаем кэш обоих файлов пресета
!!FU(ClearIniCache):P^Runtime/h3Balancer_preset.ini^;
!!FU(ClearIniCache):P^h3Balancer_preset.ini^;

; 2. Сначала читаем пресет из папки мода сразу в глобальные переменные.
;    Если файла в папке мода нет — подставятся константы H3DB_...
!!FU(ReadIniInts):P^h3Balancer_preset.ini^/^difficulty^/
  ^startFromDay^/?i^h3db_startFromDay^/(H3DB_START_FROM_DAY)/
  ^adjustmentAmount^/?i^h3db_adjustmentAmount^/(H3DB_ADJUSTMENT_AMOUNT);

!!FU(ReadIniInts):P^h3Balancer_preset.ini^/^smoothing^/
  ^emaGrowthPct^/?i^h3db_emaGrowthPct^/(H3DB_EMA_GROWTH_PCT)/
  ^emaDecayPct^/?i^h3db_emaDecayPct^/(H3DB_EMA_DECAY_PCT)/
  ^emaSnapThreshold^/?i^h3db_emaSnapThreshold^/(H3DB_EMA_SNAP_THRESHOLD);

!!FU(ReadIniInts):P^h3Balancer_preset.ini^/^aiResourceModifiers^/
  ^minResForReduce^/?i^h3db_minResForReduce^/(H3DB_MIN_RES_FOR_REDUCE);

; 3. Если это НЕ принудительная перезагрузка из папки мода (forceFromMod <> 1),
;    читаем поверх бэкап из Runtime/h3Balancer_preset.ini.
;    Если какого-то ключа в Runtime нет — останется значение из папки мода, прочитанное на Шаге 2.
!!if&(forceFromMod)<>1;
  !!FU(ReadIniInts):P^Runtime/h3Balancer_preset.ini^/^difficulty^/
    ^startFromDay^/?i^h3db_startFromDay^/i^h3db_startFromDay^/
    ^adjustmentAmount^/?i^h3db_adjustmentAmount^/i^h3db_adjustmentAmount^;

  !!FU(ReadIniInts):P^Runtime/h3Balancer_preset.ini^/^smoothing^/
    ^emaGrowthPct^/?i^h3db_emaGrowthPct^/i^h3db_emaGrowthPct^/
    ^emaDecayPct^/?i^h3db_emaDecayPct^/i^h3db_emaDecayPct^/
    ^emaSnapThreshold^/?i^h3db_emaSnapThreshold^/i^h3db_emaSnapThreshold^;

  !!FU(ReadIniInts):P^Runtime/h3Balancer_preset.ini^/^aiResourceModifiers^/
    ^minResForReduce^/?i^h3db_minResForReduce^/i^h3db_minResForReduce^;
!!en;

; 4. Сохраняем итоговый набор ключей обратно в Runtime/h3Balancer_preset.ini
!!FU(h3db_SavePresetToRuntime):P;

; Сохранение текущих значений пресета в Runtime/h3Balancer_preset.ini
; Не затрагивает h3Balancer.ini и не затирает прочие ключи в Runtime-пресете
!?FU(h3db_SavePresetToRuntime);
!!FU(WriteIniInts):P^Runtime/h3Balancer_preset.ini^/^difficulty^/
  ^startFromDay^/i^h3db_startFromDay^/
  ^adjustmentAmount^/i^h3db_adjustmentAmount^;

!!FU(WriteIniInts):P^Runtime/h3Balancer_preset.ini^/^smoothing^/
  ^emaGrowthPct^/i^h3db_emaGrowthPct^/
  ^emaDecayPct^/i^h3db_emaDecayPct^/
  ^emaSnapThreshold^/i^h3db_emaSnapThreshold^;

!!FU(WriteIniInts):P^Runtime/h3Balancer_preset.ini^/^aiResourceModifiers^/
  ^minResForReduce^/i^h3db_minResForReduce^;

!!FU(SaveIni):P^Runtime/h3Balancer_preset.ini^;


; Сброс пресета — удаление из Runtime и перезагрузка из папки мода
!?FU(h3db_ResetPresetToDefault);
; 1. Очищаем RAM-кэш и физически удаляем файл пользователя из Runtime/
!!FU(ClearIniCache):P^Runtime/h3Balancer_preset.ini^;
!!FU(FileExists):P^Runtime/h3Balancer_preset.ini^/?(exists:y);
!!if&(exists)=(TRUE);
  !!FU(DeleteFile):P^Runtime/h3Balancer_preset.ini^/?(isDeleted:y);
!!en;

; 2. Заново загружаем чистые значения из папки мода в память и пересоздаем Runtime-файл
!!FU(h3db_LoadAndSyncPresetIni):P;